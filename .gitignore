# Python bytecode / build metadata
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# uv-managed virtual environment
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# GSD planning tool state — regeneratable from committed .planning/ content,
# not meant to be tracked (research/.cache/ is a literal HTTP response cache;
# state.json is a derived snapshot of ROADMAP.md's phase statuses).
.planning/research/.cache/
.planning/state.json

# AI tooling installs — local dev-tool configuration, not project source.
.claude/
.opencode/
.gsd/

# Local environment file — load-bearing: keeps a real DATABASE_URL / GITHUB_TOKEN out of git
.env

# Per-run artifact content (Phase 4). The config set — .dark-factory.yaml,
# .dark-factory/roles/, .dark-factory/instructions/ — stays tracked source.
#
# This rule keeps run-artifact content out of the base branch's permanent
# history (D-11): a normal `git add` / `git status` on the base branch never
# sees it. The same content is deliberately force-added (`git add -f`) onto
# each run's own working branch, so it travels with a clone of that branch —
# see `dark_factory.git.diff.commit_run_artifacts` (D-09). The PR-bound diff
# (`dark_factory.git.diff.collect_pr_diff`, D-10) excludes the whole
# `.dark-factory` path at diff-computation time, so none of it ever reaches
# a pull request either. A force-add in the source and an ignore rule here
# are not in tension — this comment is the reconciliation.
.dark-factory/runs/
