# Dark Factory — environment variable reference.
#
# Copy this file to `.env` and replace every value with a real one. `.env` is
# git-ignored (see .gitignore); this file documents variable NAMES only and every
# value below is a visibly-fake placeholder — never paste a real host, user,
# password or token here.

# Pooled Neon connection string (the "-pooler" host) — used by the application at runtime.
DATABASE_URL=postgresql+psycopg://EXAMPLE_USER:EXAMPLE_PASSWORD@ep-example-000000-pooler.us-east-2.aws.neon.tech/darkfactory

# Direct (non-pooled) Neon connection string — used by Alembic only, because DDL
# and PgBouncer transaction pooling do not mix.
DATABASE_URL_DIRECT=postgresql+psycopg://EXAMPLE_USER:EXAMPLE_PASSWORD@ep-example-000000.us-east-2.aws.neon.tech/darkfactory

# structlog output level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Lease knobs (single-owner execution, Phase 2) ---------------------------
# Unlike every other entry in this file these two are NOT secrets: the values
# below are the genuine production defaults, and you normally leave them unset.

# LEASE_TTL_SECONDS — how long, in seconds, a claimed run stays owned without a
# renewal. A process that is advancing a run holds a lease with this expiry; its
# heartbeat (below) keeps pushing the expiry forward while a step runs. If that
# process is killed, no other process can claim the run until this many seconds
# have elapsed on the DATABASE clock — this phase has no "force steal" escape
# hatch, so a larger value means a longer stall before a crashed run is picked
# up again.
LEASE_TTL_SECONDS=900

# LEASE_HEARTBEAT_SECONDS — how often, in seconds, the owning process pushes its
# lease expiry forward while a role step is in flight. It MUST be strictly less
# than LEASE_TTL_SECONDS or settings loading fails at startup. The ratio matters
# more than the absolute value: one third of the TTL is the standard choice, so
# that two consecutive missed renewals still land inside the TTL before the
# lease is considered expired.
LEASE_HEARTBEAT_SECONDS=300

# GitHub token — unused in Phase 1, but loaded so the redaction layer (Plan 03)
# knows its literal value for exact-substring scrubbing (D-16).
GITHUB_TOKEN=ghp_EXAMPLE0000000000000000000000000000
